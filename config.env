# Cost Guard Configuration

# === Instance Configuration ===
INSTANCE_ID=""  # Empty = auto-detect from the instance metadata service. Set to override.

# === Behavior Thresholds ===
# TODO: Add test/production mode switching
CPU_THRESHOLD=10                  # % threshold for idle detection (5-min load avg)
IDLE_THRESHOLD_SECONDS=1800       # Seconds idle before shutdown (30 min)
MIN_UPTIME_SECONDS=600            # Minimum uptime before allowing shutdown (10 min)

# === GPU Monitoring (NVIDIA only) ===
# A VM is idle only when CPU and GPU are both idle.
GPU_MONITORING="auto"             # auto = use GPU if nvidia-smi exists, on = require it, off = CPU only
GPU_THRESHOLD=5                   # % GPU utilization below which the GPU is "idle"
GPU_SAMPLES=5                     # Samples per check (max is used)
GPU_SAMPLE_INTERVAL=2             # Seconds between samples
GPU_MEMORY_THRESHOLD_MB=0         # >0: GPU holding this much memory at 0% use gets the longer limit below. 0 = ignore memory
GPU_MEM_IDLE_THRESHOLD_SECONDS=3600  # Idle limit used instead of IDLE_THRESHOLD_SECONDS when memory is held

# === System Files ===
LOG_FILE="/var/log/cost-guard.log"              # Log file location
STATE_FILE="/var/run/cost-guard/idle_since"     # Tracks idle start time

# === Control ===
ENABLED="true"  # Set to "false" to disable without removing cron job
